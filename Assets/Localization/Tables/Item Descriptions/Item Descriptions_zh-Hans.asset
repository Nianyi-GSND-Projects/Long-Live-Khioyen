%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Item Descriptions_zh-Hans
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: zh-Hans
  m_SharedData: {fileID: 11400000, guid: 42df08062e17ca94684b5a036b7db240, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 121004318720
    m_Localized: "\u7528\u4E8E debug \u7684\u6D4B\u8BD5\u88C5\u5907\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000000
    m_Localized: 轮台产铁锻制的制式军刀。刀身厚重，利于步斗冲阵，将领配此刀上阵有统御士气的实战效果。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000100000000
    m_Localized: 一面铜包边战鼓与配套令旗。严整的鼓点能让全军在混乱中回归纪律，是校尉约束部队不可或缺的信物。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000200000000
    m_Localized: 精制的居延周边地形沙盘木刻图。将领持此可快速读取地势，于布阵时占得先机。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000300000000
    m_Localized: 登记居延屯田出入的细致账本。持此账册者能更好地掌握粮草调度，安抚屯民，减少内部摩擦。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000400000000
    m_Localized: "刻有\"大汉西域都护\"字样的通关凭信。持此信件出使或接待乌孙、车师使节时威仪更显，盟约更易缔结。"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000500000000
    m_Localized: 车师解围后，常惠带来的乌孙精锐遗落的草原弯刀。以匈奴曲角強化刀背，锋利程度远超汉军制式刀，将领一马当先可激励部队冲锋。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000600000000
    m_Localized: 车师守城战中缴获的车师驻扎重型武器。戟头厚重，守城时用于格挡骑兵冲击，将领亲持可增强部队防线。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000700000000
    m_Localized: 汉军校尉专用的鎏铜皮鞭，兼具震慑与礼器功能。持此者行军时军纪严整，兵败逃散者极少。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000800000000
    m_Localized: 嵌有铜哨的轻型信旗，用于前军斥候传递敌情。持旗将领的部队能先于敌军掌握地势，扩张视野。
    m_Metadata:
      m_Items: []
  - m_Id: 80000000900000000
    m_Localized: 记录西域地形下快速迂回战法的军事帛书。熟读此书的将领能指挥部队在复杂地形中完成策略机动。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001000000000
    m_Localized: 西域工匠特制的波斯传入的水晶透镜组件，可远眺数里地形。持此将领视野大幅扩张，掌握战场态势。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001100000000
    m_Localized: 详细标注各类西域土垒弱点的攻城图册。将领据此指挥，部队攻坚时能更快找到破绽。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001200000000
    m_Localized: 刻有赈济令文的木质令牌。持令接收降附或解救的平民时，更多人愿意加入汉军序列，兵源扩充效果显著。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001300000000
    m_Localized: 指挥辎重队伍同行作战的专用铜鼓。鼓声稳定，行军时后勤通畅，全军士气波动更小，上限更高。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001400000000
    m_Localized: 乌孙盟军交予汉军将领的协同信物。混编作战时乌孙士兵更听从持印将领的调度，联合部队的阵型变换效率更高。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001500000000
    m_Localized: "常惠援车师时所持的将帅佩剑，刻有\"长罗\"二字。作为历史性器物，持剑将领在战场上本身即是激励。"
    m_Metadata:
      m_Items: []
  - m_Id: 80000001600000000
    m_Localized: 记录郑吉等前辈西域屯田经验的简册合集，内有驻防布阵、粮草节流、斥候部署三种战法要义。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001700000000
    m_Localized: 用天山陨铁与匈奴角弓工艺合造的强弓，弓弦以天马遗骨打磨的弹片为内芯增力，射程与穿甲力均属顶尖。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001800000000
    m_Localized: 乌孙国王廷象征性战幡，以西极天马尾毛编制，持幡将领的部队在联合作战时声望极高，更多外藩愿意跟随协同。
    m_Metadata:
      m_Items: []
  - m_Id: 80000001900000000
    m_Localized: 将居延周边周边地形勘探成果刻于车师玉髓简牍上的绝版战术资料，兼具情报整合与安抚民心双重价值。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002000000000
    m_Localized: 汉宣帝认可居延正式纳入版图后下发的行政军令铁简，代表汉廷意志在西域的最高权威落地。持此令的将领拥有超越常规的协调权力。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002100000000
    m_Localized: 从击溃的匈奴骨都侯手中夺下的狼图腾旗帜，其上残留着草原的凛冽威压。在一片两军胶着的战场上树起此旗，能令敌军军心动摇、阵线松动。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002200000000
    m_Localized: 百年之前，汉武帝御赐霍去病的战袍复刻片，内里用极罕见的西域赤乌陨金制成软鳞。举旗前进，仿佛骠骑将军之威重临，敌军避退。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002300000000
    m_Localized: 乌孙国最高军权象征的两半虎符之一。持有者拥有调动乌孙全境军队的合法性，可以从乌孙获取军事支援。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002400000000
    m_Localized: 匈奴骑兵常用的骨制小哨箭。箭杆已折断，哨口也裂了，但仍能卖给工匠回收骨料。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002500000000
    m_Localized: 底座刻着“建元”字样的残破汉陶。它是早年汉军在此驻扎的痕迹，如今却被风沙掩埋在废墟中。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002600000000
    m_Localized: 不知是骆驼肉还是马肉，硬得像石头。西域的商贾或底层佣兵愿意花几个铜钱买下它用来果腹。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002700000000
    m_Localized: 车师牧民用来抵御严寒的帐篷材料残片，散发着浓烈的膻味。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002800000000
    m_Localized: 早已被大汉朝廷废止流通的半两钱，在偏远的西域偶尔还能从沙堡废墟中刨出，被走私客当做纪念品收购。
    m_Metadata:
      m_Items: []
  - m_Id: 80000002900000000
    m_Localized: 用猛禽腿骨制成的短笛。夜深人静时，匈奴轻骑常吹响它，声音凄厉，能让新兵彻夜难眠。有不少中原士大夫喜欢收集这种异域响器。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003000000000
    m_Localized: 本是大汉赏赐给西域诸国的昂贵丝绸，却在劫掠中被撕碎并染上了暗红的血迹。洗净后依然价值不菲。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003100000000
    m_Localized: 木简上用汉隶写着西域商队的名字和盖的关卡印。可惜它的主人已丧命大漠，它如今只能当作古董卖掉。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003200000000
    m_Localized: 西域大漠中狡诈沙狼的獠牙，因长年撕咬腐肉带有微毒。巫医或匈奴祭祀常愿意出高价收购。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003300000000
    m_Localized: 图案磨损严重的青铜镜，照不出人影，但镜背上的连兽纹饰证明它曾是某个贵族家宅的物件。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003400000000
    m_Localized: 记录了敦煌至车师一线所有商路行价与黑市交易的帛书。对其进行销赃能换来一笔横财。字里行间，满是被劫掠的血泪。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003500000000
    m_Localized: 匈奴贵族马具上的华丽挂件。草原上的铁骑没有马镫也能纵横驰骋，这种鎏金件纯粹是为了彰显身份与地位。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003600000000
    m_Localized: 在汉代比黄金还要昂贵的西域香料。虽然只是一小袋，但在长安城的达官贵人那里能卖出惊人的数目。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003700000000
    m_Localized: 产自传说中于阗国的极品玉环。触手生温，水头极足，往往是被匈奴掠夺后的贡品。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003800000000
    m_Localized: 从阵亡的匈奴高级将领身上搜出的印信。将其上交或卖给谍报商人，是汉军大胜的绝佳佐证。
    m_Metadata:
      m_Items: []
  - m_Id: 80000003900000000
    m_Localized: 雕刻着狼图腾的血色玛瑙杯。匈奴王只将其赏赐给立下赫赫战功的部落首领。在中原黑市，这件艺术品能卖出天价。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004000000000
    m_Localized: 距今数百年前失落于西域的先秦百家古籍残卷。对于太学的鸿儒们而言，值得他们付出大量钱财。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004100000000
    m_Localized: 由大夏或身毒国工匠铸造的小金佛，纯金打造且带有极为罕见的西域宗教风格。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004200000000
    m_Localized: 传说中以楼兰秘法织造、每一根丝线都裹着黄金的极品布匹，在战火中幸存下来的绝品。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004300000000
    m_Localized: 宛如泣血的罕见红宝石，相传是西极天马死前的眼泪凝结而成。这是西域最为传奇的天然珍宝。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004400000000
    m_Localized: 匈奴单于亲自赐给部族首领的身份象征，刀柄纯金浇铸，镶嵌红玛瑙。一旦流入黑市将引起疯狂竞价。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004500000000
    m_Localized: 百年前大汉使节迷失于大漠时留下的残碎节杖，象征着大汉开拓西域的泣血历史，地方都护愿出重金收回。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004600000000
    m_Localized: 极为罕见而详尽的西域三十六国驻军部署源图，对远征军而言价值无法估量。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004700000000
    m_Localized: 疑似汉武帝散落于西域的绝密诏书残片，盖有皇室印信。无论是留作秘密档案还是变卖，都必定能换得倾城之财。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004800000000
    m_Localized: 乌孙国初代王廷流传下来的纯金扳指，曾是西域霸主身份的最高权力象征。
    m_Metadata:
      m_Items: []
  - m_Id: 80000004900000000
    m_Localized: 粗加工的戈壁野兽皮毛。几乎所有的制式轻甲和盾牌在打造时，都需要这东西作为内衬或蒙皮。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005000000000
    m_Localized: 轮台周边矿区产出的含杂质粗铁。它是锻打汉军环首刀和修补城墙的基础材料。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005100000000
    m_Localized: 千年不死、死而不朽的大漠胡杨。西域极其缺乏良木，结实的木头是制造长柄武器、弓身孔肩的必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005200000000
    m_Localized: 居延戍卒日常织造的麻布料。用来捆扎武器握把、制作绷带防沙布，消耗量极大。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005300000000
    m_Localized: 戈壁荒原狼的腿骨，坚固耐磨。游牧民族的弓兵喜欢用它打磨箭头和配重装饰。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005400000000
    m_Localized: 经特殊工艺暴晒、捶打而成的草原牛筋。弹性惊人，是制作强弩弩弦与投石机拉绳的核心部件。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005500000000
    m_Localized: 乌孙国特有良马的粗硬鬃毛。编织后韧性极强，刀剑难断。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005600000000
    m_Localized: 匈奴射雕手用来制作角弓主体的兽角。硬度与柔韧性的完美结合。用它强化的装备，往往带有侵略性。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005700000000
    m_Localized: 将轮台粗铁反复灌钢锻打数百次而成的顶尖金属。削铁如泥，汉军中只有高级校尉才有资格配发以此打造的兵刃。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005800000000
    m_Localized: 匈奴骨都侯的重装骑兵被击碎后留下的高硬度铁扎甲。极其厚重，是打造极品重装大铠的不二之选。
    m_Metadata:
      m_Items: []
  - m_Id: 80000005900000000
    m_Localized: 车师国绿洲深处产出的温润玉髓。用于打造能够静心明智的高级佩饰。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006000000000
    m_Localized: 一颗砸在天山脚下的黑色陨石，被匈奴巫师视为长生天降下的神物。其重量极轻，硬度却远超精钢，是铸造绝世名将神兵的梦幻素材。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006100000000
    m_Localized: 乌孙国历代只有前线战死的纯血西极天马才会留下的遗骨。带有某种神奇的震慑力，是打造统帅千军的极品信物或马具的核心。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006200000000
    m_Localized: 相传汉武帝时在西域发现的罕见天外陨石，其色赤红如乌晶，熔炼后坚不可摧。它是汉廷武库极为渴望获取的终极军事资源，更是用于锻造国之重器的绝品媒介。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006300000000
    m_Localized: 汉军边境戍卒大规模配发的制式护具，由粗皮革与少许铁扎片合制而成。是训练轻甲士兵必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006400000000
    m_Localized: 重型铁制扎甲，训练重甲士兵必需品。
    m_Metadata:
      m_Items: []
  - m_Id: 80000006500000000
    m_Localized: 产自西域领土或周边盟国的良马，是训练骑兵的必需品。
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []