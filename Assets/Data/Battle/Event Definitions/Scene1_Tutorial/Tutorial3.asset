  dialogList:
  - character: {fileID: 0}
    overrideName: 
    overridePortrait: {fileID: 0}
    useBlackboardName: 1
    nameKey: AliveKingName
    dialogText: This... this is impossible! How can the Han horses be this fast?!
  - character: {fileID: 0}
    overrideName: 
    overridePortrait: {fileID: 0}
    useBlackboardName: 1
    nameKey: AliveKingName
    dialogText: That fool! He couldn't even hold them for the time it takes to burn
      an incense stick? The Han forces are overwhelming... All units, tighten the
      formation and protect the rear!
  - character: {fileID: 11400000, guid: 78c4bb626fc20b241a6677beb9dc0ad4, type: 2}
    overrideName: 
    overridePortrait: {fileID: 0}
    useBlackboardName: 0
    nameKey: 
    dialogText: Fleeing? General Zhao, press the advantage! Leave none alive!
